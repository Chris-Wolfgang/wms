# E14.4: the compose stack's non-secret configuration. Copy to .env; scripts/compose-setup.ps1 fills the
# two connection strings (encrypted with the shared key ring, so they are safe here). Passwords live only
# in docker/secrets/*.txt (generated, git-ignored) and in the database.

# The hostname Caddy serves (a public name gets a real certificate; localhost gets an internal one).
WMS_HOSTNAME=localhost
WMS_HTTP_PORT=80
WMS_HTTPS_PORT=443

# The boot log level of every host (the runtime level is a setting; docs/LOGGING.md).
WMS_LOG_LEVEL=Information

# The worker's role: worker (singleton jobs) or ingest (file drop and connectors only).
WMS_WORKER_ROLE=worker

# Filled by scripts/compose-setup.ps1: enc:v1: strings for the runtime and the migration logins.
WMS_DB_CONNECTION=
WMS_DB_MIGRATE_CONNECTION=
