<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Core hosts module endpoint registration, so it needs the ASP.NET Core shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- E82.2: path-segment API versioning (.NET Foundation, MIT) and one OpenAPI document per version. -->
    <PackageReference Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfgang.Wms.Domain\Wolfgang.Wms.Domain.csproj" />
    <!-- E12.2: the hosts' Serilog bootstrap and the level switch the settings move. -->
    <ProjectReference Include="..\Wolfgang.Wms.Logging\Wolfgang.Wms.Logging.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- E1.9: modules map endpoints from libraries, so the request-delegate generator must run here too or
         MapGet falls back to reflection and fails the trim/AOT analyzers. Every module project sets this. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

</Project>
