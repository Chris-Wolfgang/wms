@inherits LayoutComponentBase
@inject IStringLocalizer<ConsoleText> L

@Body

<div id="blazor-error-ui" data-nosnippet>
    @L["unhandled.message"]
    <a href="." class="reload">@L["unhandled.reload"]</a>
    <button type="button" class="dismiss" aria-label="@L["unhandled.dismiss"]">🗙</button>
</div>
