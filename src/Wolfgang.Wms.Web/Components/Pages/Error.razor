@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<ConsoleText> L

<PageTitle>@L["error.title"]</PageTitle>

<h1 class="text-danger">@L["error.heading"]</h1>
<h2 class="text-danger">@L["error.subheading"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@L["error.request_id"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@L["error.development.heading"]</h3>
<p>@L["error.development.detail"]</p>
<p>@L["error.development.warning"]</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    /// <inheritdoc/>
    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
