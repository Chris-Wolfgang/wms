{
  "openapi": "3.1.1",
  "info": {
    "title": "Wolfgang.Wms API",
    "description": "Unstable contract for product 0.x: breaking changes ship in place, each with a \u0060breaking\u0060 changelog fragment.",
    "version": "0"
  },
  "paths": {
    "/api/v0/system/schema": {
      "get": {
        "tags": [
          "wms"
        ],
        "summary": "Current and expected database schema version (read-only).",
        "operationId": "GetSchemaStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/settings/registry": {
      "get": {
        "tags": [
          "wms"
        ],
        "summary": "Every setting the host knows: kind, scopes, default, description (read-only).",
        "operationId": "GetSettingRegistry",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SettingDescriptor"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/settings/{scopeType}/{scopeId}": {
      "get": {
        "tags": [
          "wms"
        ],
        "summary": "Every setting at a scope with its configured and effective value.",
        "operationId": "ListSettings",
        "parameters": [
          {
            "name": "scopeType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scopeId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SettingValue"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/settings/{scopeType}/{scopeId}/{key}": {
      "get": {
        "tags": [
          "wms"
        ],
        "summary": "One setting at a scope; the ETag is the stored row\u0027s version.",
        "operationId": "GetSetting",
        "parameters": [
          {
            "name": "scopeType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scopeId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "wms"
        ],
        "summary": "Configures a setting at a scope: a value, or a cascade mode (per_site, per_zone, per_sku); both null resets. If-Match required when a row exists.",
        "operationId": "SetSetting",
        "parameters": [
          {
            "name": "scopeType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scopeId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetSettingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingValue"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "wms"
        ],
        "summary": "Removes the configured value at a scope so it inherits again; If-Match required when a row exists.",
        "operationId": "ResetSetting",
        "parameters": [
          {
            "name": "scopeType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scopeId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingValue"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/auth/local/login": {
      "post": {
        "tags": [
          "wms"
        ],
        "summary": "Signs in a local account and sets the session cookie; 401 wrong credentials, 423 locked, 403 disabled.",
        "operationId": "LocalLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v0/auth/logout": {
      "post": {
        "tags": [
          "wms"
        ],
        "summary": "Ends the session.",
        "operationId": "Logout",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v0/auth/me": {
      "get": {
        "tags": [
          "wms"
        ],
        "summary": "Who is signed in.",
        "operationId": "GetSession",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/auth/local/password": {
      "post": {
        "tags": [
          "wms"
        ],
        "summary": "Replaces the signed-in local user\u0027s password; clears the must-change flag and refreshes the cookie.",
        "operationId": "ChangeLocalPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "description": "The password in use."
          },
          "newPassword": {
            "type": "string",
            "description": "The replacement; must satisfy PasswordPolicy."
          }
        },
        "description": "Body of \u0060POST /auth/local/password\u0060 (E9.1, E9.2)."
      },
      "LocalLoginRequest": {
        "required": [
          "userName",
          "password"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string",
            "description": "The sign-in name."
          },
          "password": {
            "type": "string",
            "description": "The password."
          }
        },
        "description": "Body of \u0060POST /auth/local/login\u0060 (E9.2)."
      },
      "SchemaStatus": {
        "required": [
          "current",
          "expected"
        ],
        "type": "object",
        "properties": {
          "current": {
            "type": [
              "null",
              "string"
            ],
            "description": "Identifier of the last applied migration, or null when no database is reachable or none was applied."
          },
          "expected": {
            "type": [
              "null",
              "string"
            ],
            "description": "Identifier of the last migration this build ships, or null before the data model exists."
          },
          "upToDate": {
            "type": "boolean",
            "description": "True when the database is at exactly the migration this build expects."
          }
        },
        "description": "The database schema as the API sees it (E82.5): the migration the database is at and the one this build\r\nexpects. Read-only; applying migrations is a bootstrap step outside the API (\u0060wms migrate\u0060)."
      },
      "SessionInfo": {
        "required": [
          "userId",
          "userName",
          "displayName",
          "mustChangePassword",
          "isLocalAdmin"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The user\u0027s id.",
            "format": "int64"
          },
          "userName": {
            "type": "string",
            "description": "The sign-in name."
          },
          "displayName": {
            "type": "string",
            "description": "The name shown on screen."
          },
          "mustChangePassword": {
            "type": "boolean",
            "description": "True while the password must be replaced before anything else."
          },
          "isLocalAdmin": {
            "type": "boolean",
            "description": "True for the break-glass administrator."
          }
        },
        "description": "Who is signed in (\u0060GET /auth/me\u0060, E9)."
      },
      "SetSettingRequest": {
        "required": [
          "value"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "null",
              "string"
            ],
            "description": "The stored text, or null."
          },
          "mode": {
            "type": [
              "null",
              "string"
            ],
            "description": "The cascade mode\u0027s stored name, or null to keep or set a value."
          }
        },
        "description": "Body of \u0060PUT /settings/{scope}/{id}/{key}\u0060 (E6.3, E7.2): a value as stored text, or a cascade mode\r\n(\u0060per_site\u0060, \u0060per_zone\u0060, \u0060per_sku\u0060) that delegates the decision downward. Both null resets\r\nthe scope to inherit (the same as \u0060DELETE\u0060); mode \u0060value\u0060 alone does the same."
      },
      "SettingDescriptor": {
        "required": [
          "name",
          "kind",
          "scopes",
          "default",
          "description",
          "choices",
          "requiresRestart",
          "triggersDeviceResync"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The setting name."
          },
          "kind": {
            "description": "How the value is edited and stored.",
            "$ref": "#/components/schemas/SettingKind"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The scope names the setting may be configured at, organisation first."
          },
          "default": {
            "type": "string",
            "description": "The default value as stored text; masked for secrets."
          },
          "description": {
            "type": "string",
            "description": "The one-line description."
          },
          "choices": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "The allowed values when the kind is a fixed list, else null."
          },
          "requiresRestart": {
            "type": "boolean",
            "description": "True when a change needs a host restart."
          },
          "triggersDeviceResync": {
            "type": "boolean",
            "description": "True when a change makes devices resync."
          }
        },
        "description": "One registry entry as the API and the console see it (E6.1): everything a settings page needs to render\r\nand validate a setting without knowing its CLR type."
      },
      "SettingKind": {
        "enum": [
          "Boolean",
          "Integer",
          "Number",
          "Enum",
          "String",
          "Duration",
          "Timestamp",
          "Secret",
          "Json"
        ],
        "description": "How a setting\u0027s value is edited and stored (E6.1). Every value is stored as invariant-culture text; the\r\nkind tells the settings page which editor to show and the accessor how to parse the text."
      },
      "SettingValue": {
        "required": [
          "name",
          "scope",
          "kind",
          "configuredValue",
          "effectiveValue",
          "inheritedFrom",
          "cascadeMode",
          "allowedModes",
          "rowVersion",
          "updatedBy",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The setting name."
          },
          "scope": {
            "type": "string",
            "description": "The scope (\u0060organization\u0060, \u0060site:3\u0060)."
          },
          "kind": {
            "description": "How the value is edited.",
            "$ref": "#/components/schemas/SettingKind"
          },
          "configuredValue": {
            "type": [
              "null",
              "string"
            ],
            "description": "The text configured at this scope, or null when it inherits."
          },
          "effectiveValue": {
            "type": "string",
            "description": "The text that applies at this scope."
          },
          "inheritedFrom": {
            "type": [
              "null",
              "string"
            ],
            "description": "The scope the effective value comes from (\u0060organization\u0060), \u0060default\u0060 for the key\u0027s default, or null when configured here."
          },
          "cascadeMode": {
            "type": "string",
            "description": "How this scope takes part in the cascade: \u0060value\u0060, or \u0060per_site\u0060/\u0060per_zone\u0060/\u0060per_sku\u0060 when it delegates (E7.2)."
          },
          "allowedModes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The modes this key allows at this scope."
          },
          "rowVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "The stored row\u0027s version, or null when no row exists at this scope yet.",
            "format": "int64"
          },
          "updatedBy": {
            "type": [
              "null",
              "string"
            ],
            "description": "Who last wrote the row, if one exists."
          },
          "updatedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "When the row was last written, if one exists.",
            "format": "date-time"
          },
          "etag": {
            "type": [
              "null",
              "string"
            ],
            "description": "The entity tag of the stored row (\u0060If-Match\u0060 on writes), or null when no row exists."
          }
        },
        "description": "One setting at one scope as the API and the console see it (E6.3): what is configured here, what\r\napplies here, and where the effective value comes from when it is inherited. Secrets are masked."
      }
    }
  },
  "tags": [
    {
      "name": "wms"
    }
  ]
}
