<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Coverlet resolves the references of [GeneratedCode] members (e.g. [LoggerMessage] output) while it
         instruments a module; without the compilation context it cannot find Microsoft.Extensions.Logging.Abstractions
         on the Linux runner, skips Wolfgang.Wms.Infrastructure entirely, and the unit tests' coverage of it is lost
         (CecilAssemblyResolutionException in the coverlet diagnostics). -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.11.3" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.Wms.Domain\Wolfgang.Wms.Domain.csproj" />
    <ProjectReference Include="..\..\src\Wolfgang.Wms.Api\Wolfgang.Wms.Api.csproj" />
    <ProjectReference Include="..\..\src\Wolfgang.Wms.Infrastructure\Wolfgang.Wms.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Wolfgang.Wms.Core\Wolfgang.Wms.Core.csproj" />
    <ProjectReference Include="..\..\src\Wolfgang.Wms.Web.Shared\Wolfgang.Wms.Web.Shared.csproj" />
    <ProjectReference Include="..\..\src\Wolfgang.Wms.Client\Wolfgang.Wms.Client.csproj" />
    <ProjectReference Include="..\..\src\Wolfgang.Wms.Web.Configure\Wolfgang.Wms.Web.Configure.csproj" />
    <ProjectReference Include="..\..\src\Wolfgang.Wms.Web.Supervise\Wolfgang.Wms.Web.Supervise.csproj" />
    <ProjectReference Include="..\..\src\Wolfgang.Wms.Web.Resolve\Wolfgang.Wms.Web.Resolve.csproj" />
    <ProjectReference Include="..\..\src\Wolfgang.Wms.Web.Report\Wolfgang.Wms.Web.Report.csproj" />
    <ProjectReference Include="..\..\src\Wolfgang.Wms.Web.Insights\Wolfgang.Wms.Web.Insights.csproj" />
    <ProjectReference Include="..\..\src\Wolfgang.Wms.Web\Wolfgang.Wms.Web.csproj" />
    <ProjectReference Include="..\..\src\Wolfgang.Wms.Migrate\Wolfgang.Wms.Migrate.csproj" />
  </ItemGroup>

</Project>