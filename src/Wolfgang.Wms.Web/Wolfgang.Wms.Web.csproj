<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- E15.2: IIS hosts the console in-process (web.config is generated on publish). -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- E82.4: one deployable, five workspaces in their own projects; the console is an API client only. -->
    <ProjectReference Include="..\Wolfgang.Wms.Domain\Wolfgang.Wms.Domain.csproj" />
    <!-- E15.1: runs as a Windows service (scripts/Install-WindowsServices.ps1); a no-op elsewhere. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <!-- E12.2: the same log pipeline as the API (host plumbing, not business logic). -->
    <ProjectReference Include="..\Wolfgang.Wms.Logging\Wolfgang.Wms.Logging.csproj" />
    <ProjectReference Include="..\Wolfgang.Wms.Web.Shared\Wolfgang.Wms.Web.Shared.csproj" />
    <ProjectReference Include="..\Wolfgang.Wms.Web.Configure\Wolfgang.Wms.Web.Configure.csproj" />
    <ProjectReference Include="..\Wolfgang.Wms.Web.Supervise\Wolfgang.Wms.Web.Supervise.csproj" />
    <ProjectReference Include="..\Wolfgang.Wms.Web.Resolve\Wolfgang.Wms.Web.Resolve.csproj" />
    <ProjectReference Include="..\Wolfgang.Wms.Web.Report\Wolfgang.Wms.Web.Report.csproj" />
    <ProjectReference Include="..\Wolfgang.Wms.Web.Insights\Wolfgang.Wms.Web.Insights.csproj" />
  </ItemGroup>

</Project>
