<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- E2: EF Core with both supported providers; the installer picks one at run time (Wms:Database:Provider).
         Npgsql (PostgreSQL licence, permissive) sits behind WmsDbContext and the repositories, never used directly. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <!-- E6.4: one audit store for every audited table (Chris-Wolfgang library; Model 1, AuditingDbContext). -->
    <PackageReference Include="Wolfgang.AuditTrail.EntityFrameworkCore" Version="0.4.1" />
    <!-- E8.6: the Data Protection key ring in the database (wms.data_protection_key) so instances share one ring. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <!-- Security pins for transitive packages: Microsoft.Data.SqlClient brings System.Security.Cryptography.Pkcs 9.0.11
         and Data Protection brings Pkcs/Xml 10.0.12, all vulnerable (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7,
         GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83). Remove once the parents ship with 10.0.13+. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfgang.Wms.Core\Wolfgang.Wms.Core.csproj" />
    <ProjectReference Include="..\Wolfgang.Wms.Domain\Wolfgang.Wms.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- E1.9: EF Core (DbContext, migrations) is reflection-based and not trim/AOT-clean, so the analyzers are
         off here and the assembly is rooted (not trimmed) at publish; the API publishes JIT + ReadyToRun until
         EF supports NativeAOT. Configuration binding uses the source generator regardless. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

</Project>
