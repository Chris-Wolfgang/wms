<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- E12.2: Serilog (Apache 2.0). AspNetCore brings hosting, the console and file sinks and the compact JSON
         formatter; the Windows Event Log, OpenTelemetry and async sinks are separate packages. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The OpenTelemetry and Event Log sinks are not trim/AOT annotated; like Infrastructure, this project is
         excluded from the AOT analyzers (hosts stay JIT until the stack is). -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

</Project>
