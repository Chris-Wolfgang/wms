<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>wms-migrate</AssemblyName>
    <RootNamespace>Wolfgang.Wms.Migrate</RootNamespace>
    <!-- E4 / E1.9: the migrate tool runs EF migrations in-process, so it publishes JIT (never NativeAOT) as a
         separate executable next to the AOT CLI. Analyzers for trimming/AOT are off like Infrastructure's. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfgang.Wms.Infrastructure\Wolfgang.Wms.Infrastructure.csproj" />
    <ProjectReference Include="..\Wolfgang.Wms.Infrastructure.Migrations.SqlServer\Wolfgang.Wms.Infrastructure.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\Wolfgang.Wms.Infrastructure.Migrations.PostgreSql\Wolfgang.Wms.Infrastructure.Migrations.PostgreSql.csproj" />
  </ItemGroup>

</Project>
