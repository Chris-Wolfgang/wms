<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wolfgang.Wms.Infrastructure.Migrations.PostgreSql</RootNamespace>
    <!-- E2.4: PostgreSQL migrations for WmsDbContext, generated by scripts/Check-Migrations.ps1 -Add <Name>
         (dotnet ef) against the design-time factory below; never hand-edited except to add index comments (E3.5).
         Generated code: not measured (coverlet.runsettings) and not trim/AOT analysed (EF, E1.9). -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfgang.Wms.Infrastructure\Wolfgang.Wms.Infrastructure.csproj" />
  </ItemGroup>

</Project>
