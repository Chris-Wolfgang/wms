<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Android only (E1.5): the device app targets handheld scanners; no iOS/macOS/Windows heads. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Wolfgang.Wms.Android</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Display name and application id are brand-neutral until the E1.0 ADR picks the product name. -->
    <ApplicationTitle>Wolfgang.Wms</ApplicationTitle>
    <ApplicationId>com.wolfgang.wms.device</ApplicationId>
    <!-- Placeholders; WmsAndroidVersionFromTag below overwrites both from the MinVer-derived version (E85.4). -->
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfgang.Wms.Domain\Wolfgang.Wms.Domain.csproj" />
  </ItemGroup>

  <!-- E85.4: versionName is the SemVer string from the tag; versionCode = major*10000 + minor*100 + patch,
       so every release has a higher code than the last and the code identifies the version. Runs after MinVer
       (Directory.Build.props) and is a no-op when MinVer is absent. -->
  <Target Name="WmsAndroidVersionFromTag" AfterTargets="MinVer" Condition="'$(MinVerMajor)' != ''">
    <PropertyGroup>
      <ApplicationDisplayVersion>$(MinVerVersion)</ApplicationDisplayVersion>
      <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(MinVerMajor), 10000)), $([MSBuild]::Multiply($(MinVerMinor), 100)))), $(MinVerPatch)))</ApplicationVersion>
    </PropertyGroup>
  </Target>

</Project>
