<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The OIDC handler and its discovery/validation stack (Microsoft, MIT). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfgang.Wms.Core\Wolfgang.Wms.Core.csproj" />
    <ProjectReference Include="..\Wolfgang.Wms.Domain\Wolfgang.Wms.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- E11.1: the OpenID Connect handler and Microsoft.IdentityModel are not trim/AOT annotated; like
         Infrastructure (EF), this project is excluded from the AOT analyzers (hosts stay JIT until the stack is). -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

</Project>
